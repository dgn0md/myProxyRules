#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
NODE_VERSION=$(cat "$ROOT/.node-version")
if [ -L "$ROOT/.local" ]; then
  echo "拒绝使用工作区外部链接：$ROOT/.local" >&2
  exit 1
fi
SYSTEM=$(uname -s)
ARCH=$(uname -m)
case "$SYSTEM:$ARCH" in
  Darwin:arm64) PLATFORM=darwin-arm64 ;;
  Linux:x86_64) PLATFORM=linux-x64 ;;
  *)
    echo "本地 Node 工具链暂不支持 $SYSTEM/$ARCH" >&2
    exit 1
    ;;
esac
NODE_BIN="$ROOT/.local/toolchain/node-v$NODE_VERSION-$PLATFORM/bin"
if [ ! -x "$NODE_BIN/node" ]; then
  echo "项目本地 Node 尚未安装。请运行 ./tools/bootstrap-local-environment.sh" >&2
  exit 1
fi
LOCAL="$ROOT/.local"
mkdir -p "$LOCAL/home" "$LOCAL/tmp"
export HOME="$LOCAL/home"
export TMPDIR="$LOCAL/tmp"
export PATH="$NODE_BIN:$PATH"
export NODE_USE_ENV_PROXY=1
export MYPROXY_LOCAL_RUNTIME=1
unset NODE_PATH NODE_OPTIONS NPM_CONFIG_PREFIX npm_config_prefix
if [ "$#" -gt 0 ] && [ "$1" = "--print-bin" ]; then
  printf '%s\n' "$NODE_BIN"
  exit 0
fi
exec "$NODE_BIN/node" "$@"
